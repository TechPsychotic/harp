<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing (4×2 and up): the song with a big cover, or its live lyrics. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_clip" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_bg" />
    <LinearLayout android:id="@+id/widget_plain" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp" >
        <ImageView android:id="@+id/widget_art" android:layout_width="96dp" android:layout_height="96dp"
            android:contentDescription="Cover" android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="2" android:text="Harp" android:textColor="#FFF5F5F7" android:textSize="16sp"
            android:fontFamily="sans-serif-medium"   />
            <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:text="Tap to open" android:textColor="#FFA1A1A6" android:textSize="13sp"
            android:fontFamily="sans-serif"   />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:layout_marginStart="-6dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/widget_prev" android:layout_width="34dp" android:layout_height="34dp"
            android:background="@android:color/transparent" android:contentDescription="Previous" android:padding="7dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_w_prev" />
                <ImageButton android:id="@+id/widget_play" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_play_bg"
            android:contentDescription="Play or pause" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_w_play" />
                <ImageButton android:id="@+id/widget_next" android:layout_width="34dp" android:layout_height="34dp"
            android:background="@android:color/transparent" android:contentDescription="Next" android:padding="7dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_w_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_lyrics" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_art_l" android:layout_width="40dp" android:layout_height="40dp"
                android:contentDescription="Cover" android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_title_l" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:text="Harp" android:textColor="#FFF5F5F7" android:textSize="13sp"
            android:fontFamily="sans-serif-medium"   />
            <TextView android:id="@+id/widget_artist_l" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:text="Tap to open" android:textColor="#FFA1A1A6" android:textSize="11sp"
            android:fontFamily="sans-serif"   />
            </LinearLayout>
            <ImageButton android:id="@+id/widget_prev_l" android:layout_width="30dp" android:layout_height="30dp"
            android:background="@android:color/transparent" android:contentDescription="Previous" android:padding="6dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_w_prev" />
            <ImageButton android:id="@+id/widget_play_l" android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_play_bg"
            android:contentDescription="Play or pause" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_w_play" />
            <ImageButton android:id="@+id/widget_next_l" android:layout_width="30dp" android:layout_height="30dp"
            android:background="@android:color/transparent" android:contentDescription="Next" android:padding="6dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_w_next" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_lyric" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="2" android:text="" android:textColor="#FFF5F5F7" android:textSize="19sp"
            android:fontFamily="sans-serif-medium"   />
            <TextView android:id="@+id/widget_lyric_next" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="#FF6E6E73" android:textSize="14sp"
            android:fontFamily="sans-serif"  android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
